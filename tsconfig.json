{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["react"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "example/App.tsx", "tests/api.test.ts"]
}
